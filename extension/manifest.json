{
  "manifest_version": 3,
  "name": "Memecoin Paper Trader for Axiom",
  "version": "1.0.0",
  "description": "Paper trade Solana memecoins on Axiom with live market cap, fees and INR profit.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://open.er-api.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://axiom.trade/*", "*://*.axiom.trade/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
